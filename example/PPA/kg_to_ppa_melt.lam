#
#  LAMMPS script to apply PPA to melts using the iPPA force field transformation
#
#  Assumptions internal beads should be type 1 and they are allowed to relax, 
#              end beads should be type 2, and they are fixed in space.
#
#   Process: 
#       1) The melt is frozen to T=0 with the KG force field during ${runfreeze} = 1000 steps
#       2) The iPPA is run removing interactions within ${nwindow}=10 during a simulation of ${runippa} = 10000 steps.
#       3) Energy minimizatio is run for 50000 steps.
#       4) T=0 Langevin dynamics is run for ${runrelax}=500000 steps.
#       5) Energy minimizatio is run for 50000 steps.
#       6) Configuration is saved.
#
#  During the simulation lppa.t stores statistics of bond lengths  note this is not saved
#  during minimization.
#

variable zero equal 0.0
variable unity equal 1.0

units              lj

boundary           p p p
atom_style         molecular
neighbor           2.00 bin
neigh_modify       every 1 delay 0 check yes
neigh_modify       one 5000

#setup global parameters:
include "param.lam"

read_data ${input}
mass * ${mass}

#setup all computes:

compute pdist      all  pair/local dist
compute bdist      all  bond/local dist
compute bmax all   reduce max c_bdist    inputs local
compute bmin all   reduce min c_bdist    inputs local
compute bavg all   reduce ave c_bdist    inputs local
compute bavg2 all  reduce avesq c_bdist  inputs local
compute pmin all   reduce min c_pdist    inputs local


fix bondstat   all  ave/time 100 1 100      c_bavg  c_bavg2    file lppa.t

group mobile type 1
group fixed type 2

fix zero fixed setforce 0 0 0 
fix integrator mobile nve/limit 0.1


#freeze KG config
print "+---------------------------------------------------------------------------+"
print "| Freezing the configuration                                                |"

#
#  Small stage to cool down the KG model before starting the PPA contraction process.
#  High friction, small timesteps, large spring constant.
#

pair_style      lj/cut ${cutoff}
pair_coeff      * * 1.0 1.0
pair_modify     shift yes

bond_style      fenehalt
bond_coeff      *   ${kspring} 1.5 0.0 1.0 1.40

angle_style     cosine
angle_coeff     * ${kappa}
special_bonds lj 1 1 1

variable unity equal 1.0
thermo_style custom step temp epair ebond eangle c_bmin  c_bavg  c_bmax  c_pmin  v_unity
thermo 10

fix dynamics   mobile langevin ${tfreeze} ${tfreeze}   ${tdampfreeze}   325439524
timestep ${tstepfreeze}
run ${runfreeze}
unfix dynamics

#Go to PPA state
print "+---------------------------------------------------------------------------+"
print "| Converting KG to PPA   using the iPPA force field transformation          |"


variable kppa2 equal 50
variable kppaspring equal 2*${kppa2}


pair_style      wca/ppa   window ${nwindow} alpha ${power}  lambda  1.0  ${geometry}  u0 ${u0}
pair_coeff      * * 1.0 1.0
special_bonds lj 1 1 1

bond_style      poly06
bond_coeff      *  0     0  0  ${kppa2} 0 0  0   100
angle_style     none

variable ramp_down equal "ramp(1.00,0.00)"
thermo 10
thermo_style custom step temp epair ebond eangle c_bmin  c_bavg  c_bmax  c_pmin v_ramp_down  

timestep ${tstepppa}
fix iPPA      all    adapt  1  pair wca/ppa lambda ${atypebead} ${atypebead} v_ramp_down
fix dynamics   mobile langevin ${ppatemp} ${ppatemp}   ${tdampppa}   325439524
run ${runippa}
unfix iPPA
unfix dynamics

print "+---------------------------------------------------------------------------+"
print "| Relaxing the PPA                                                          |"

thermo_style custom step temp epair ebond eangle c_bmin  c_bavg  c_bmax  c_pmin  v_zero
timestep 0.01

pair_style      wca/ppa   window ${nwindow} alpha ${power}  lambda  0.0  ${geometry}  u0 ${u0}
pair_coeff      * *   1.0 1.0
special_bonds lj 1 1 1

bond_style      poly06
bond_coeff      *  0     0  0  ${kppa2} 0 0  0   100
angle_style     none

#energy minimization
min_modify dmax 0.1
minimize 1e-10 1e-10 50000 50000

#Langevin dynamics
fix dynamics   mobile langevin ${ppatemp} ${ppatemp}   ${tdamprelax}   325439524
timestep ${tsteprelax}
run ${runrelax}
unfix dynamics

#energy minimization
min_modify dmax 0.1
minimize 1e-10 1e-10 50000 50000

#Short run to save bond statistic after the final energy minimization

fix dynamics   mobile langevin ${ppatemp} ${ppatemp}   ${tdamprelax}   325439524
timestep ${tsteprelax}
run 10000
unfix dynamics

unfix bondstat

print "+---------------------------------------------------------------------------+"
print "| Saving the PPA                                                            |"

write_data ppa.data  nocoeff
shell gzip --force ppa.data


